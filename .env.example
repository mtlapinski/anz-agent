ANTHROPIC_API_KEY=    # https://console.anthropic.com
GOOGLE_API_KEY=       # https://aistudio.google.com/app/apikey
SERPAPI_KEY=          # https://serpapi.com — 100 free searches/month
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Set automatically by docker-compose.yml for app-1/app-2. Set manually
# (pointed at localhost:5432) when running scripts/migrate_cache_to_postgres.py
# from the host, or when running the app outside Compose against Postgres.
DATABASE_URL=

# Set automatically by docker-compose.yml for app-1/app-2, pointed at the
# judge Compose service (http://judge:8001/match), routing cache-matching
# judge calls over the network instead of running them in-process. Unset
# (the default outside Compose) runs the judge in-process — set manually
# only to point at a standalone judge_service.py instance elsewhere.
CACHE_JUDGE_URL=
